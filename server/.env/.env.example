# 应用配置
APP_NAME=OpenAdmin
APP_VERSION=1.0.0
APP_DEBUG=True

# API 配置
APP_API_PREFIX=/api

# 跨域配置
APP_CORS_ALLOW_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=True
APP_CORS_ALLOW_METHODS=*
APP_CORS_ALLOW_HEADERS=*
APP_CORS_EXPOSE_HEADERS=*
APP_CORS_MAX_AGE=600

# 日志配置（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_STDOUT_LEVEL=DEBUG
LOG_FILE_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION="10 MB"
LOG_RETENTION="7 days"
LOG_BACKTRACE=True
LOG_DIAGNOSE=True
LOG_JSON_FORMAT=True

# 文档配置
APP_DOCS_ENABLE=True
APP_DOCS_TITLE=OpenAdmin 后台管理系统
APP_DOCS_DESCRIPTION=基于 FastAPI + Vue3 开发的开源后台管理系统，提供完整的用户管理、权限控制、数据管理等功能。
APP_DOCS_VERSION=1.0.0
APP_DOCS_CONTACT_NAME=sjzhao
APP_DOCS_CONTACT_EMAIL=1500492856@qq.com
APP_DOCS_URL=/docs
APP_REDOC_URL=/redoc

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=username
DB_PASSWORD=password
DB_NAME=openadmin
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_DEBUG=True

# JWT 配置
AUTH_JWT_SECRET_KEY=secret-key
AUTH_JWT_REFRESH_SECRET_KEY=refresh-secret-key
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENCODING=utf-8
REDIS_DECODE_RESPONSES=True
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=10
REDIS_MAX_CONNECTIONS=50

# ==================== LLM 大语言模型配置 ====================
# 平台级凭证（所有模型共享）
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置（仅模型级别参数，平台凭证由上方统一管理）
# 字段说明：
#   model_name      - 模型名称（必填）
#   temperature     - 采样温度，范围 0-2（选填，默认 0.7）
#   max_tokens      - 最大生成 token 数（选填，默认不限制）
#   timeout         - 请求超时时间，秒（选填，默认 60）
#   enable_thinking - 是否启用推理模式（选填，默认 true，Qwen3 系列支持）
LLM_MODELS='{
    "qwen3-max": {
        "model_name": "qwen3-max",
        "temperature": 0.7,
        "max_tokens": 4096,
        "timeout": 60,
        "enable_thinking": true
    },
    "qwen3.8-max": {
        "model_name": "qwen3.8-max",
        "temperature": 0.7,
        "max_tokens": 4096,
        "timeout": 60,
        "enable_thinking": true
    },
    "qwen3.7-plus": {
        "model_name": "qwen3.7-plus",
        "temperature": 0.7,
        "max_tokens": 2048,
        "timeout": 60,
        "enable_thinking": true
    }
}'

RAG_EMBEDDING_MODEL=qwen-turbo
RAG_EMBEDDING_API_KEY=sk-your-qwen-api-key
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_DIMENSIONS=1024