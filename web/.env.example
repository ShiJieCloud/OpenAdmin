VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=3000

# ======================
# APP 应用展示信息：版权、备案、法律入口
# 说明：用于页面底部/关于页展示的对外公示信息
# 👉 开源版本全部资质类配置保持为空字符串；私有化部署时填写真实证照信息
# ======================

VITE_APP_TITLE=OpenAdmin

# ICP备案号：例如 浙ICP备2025142522号-2，开源版留空""，为空则页面不渲染该项
VITE_APP_ICP_NUMBER=""
# 公安网安备案号，例如 浙公网安备33010902004205号，为空则页面不渲染该项
VITE_APP_SECURITY_RECORD=""

# 页面展示版权完整文案，支持自定义年份、公司名称，直接修改文本内容即可
VITE_APP_COPYRIGHT_TEXT="©2024‑2026 OpenAdmin"
# 项目开源/官网外部链接，点击“开源地址”跳转；为空时隐藏该链接
VITE_APP_PROJECT_LINK="https://github.com/xxx/openadmin"
# 商务合作联系邮箱；为空则页面不渲染商务合作整项
VITE_APP_BUSINESS_EMAIL="contact@openadmin.com"
