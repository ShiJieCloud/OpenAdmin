{
  "name": "OpenAdmin",
  "description": "OpenAdmin 是基于 Vue3 + TypeScript + Vite 搭建的现代化后台管理模板，内置 Element Plus 组件库、Pinia 状态管理与 Vue Router 路由体系，集成 Tailwind CSS 实现灵活样式开发。项目内置图标自动导入、API 请求封装、Markdown 文档渲染、代码高亮等常用后台能力，开箱即用，兼顾开发效率与页面性能，可快速搭建企业级中后台管理系统。",
  "author": "sjzhao",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-vue/iconamoon": "^1.0.3",
    "@iconify-vue/meteor-icons": "^1.0.3",
    "@iconify-vue/solar": "^1.0.4",
    "@iconify/vue": "^5.0.1",
    "@shikijs/stream": "^4.4.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shiki": "^4.3.1",
    "shiki-stream": "^0.1.5",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-element-plus-x": "^2.0.3",
    "vue-router": "^4.6.4",
    "x-markdown-vue": "^0.0.202"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/meteor-icons": "^1.2.1",
